{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid || data.child('guestId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid || data.child('guestId').val() === auth.uid)",
        "guestId": {
          ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && data.parent().child('hostId').exists()"
        }
      }
    },
    "stats": {
      ".read": "auth != null && ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists())",
      "$day": {
        "$metric": {
          ".write": "auth != null && $day.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && $metric.matches(/^(devices|signups|roomsCreated|roomsJoined|cardsDrawn|cardsDone|skips|engagedGames|drawn_(light|warm|hot))$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      ".read": "auth != null && ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {".validate": "newData.isString() && newData.val().length <= 100"},
        "email": {".validate": "newData.isString() && newData.val().length <= 200"},
        "provider": {".validate": "newData.isString() && newData.val().length <= 50"},
        "createdAt": {".validate": "newData.isNumber()"},
        "lastSeen": {".validate": "newData.isNumber()"},
        "$other": {".validate": false}
      }
    },
    "subscribers": {
      ".read": "auth != null && ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists())",
      ".write": "auth != null && ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('until').isNumber()"
      }
    },
    "officialDeck": {
      ".read": "auth != null",
      ".write": "auth != null && ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists())"
    },
    "feedback": {
      ".read": "auth != null && ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists())",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('read').val() === false) || ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['uid', 'type', 'message', 'createdAt', 'read'])",
        "uid": {".validate": "newData.isString()"},
        "type": {".validate": "newData.isString() && newData.val().matches(/^(suggestion|problem|question)$/)"},
        "message": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"},
        "email": {".validate": "newData.isString() && newData.val().length <= 200"},
        "createdAt": {".validate": "newData.isNumber()"},
        "read": {".validate": "newData.isBoolean()"},
        "$other": {".validate": false}
      }
    },
    "userDecks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && ((auth.uid === '3IMTePhIFeZo5nOHwDues02yN0y2' || auth.uid === 'HuzxWxVWcbRIdkvXVs6bYi6C4F83') || root.child('admins').child(auth.uid).exists() || root.child('subscribers').child($uid).child('until').val() > now)"
      }
    }
  }
}
